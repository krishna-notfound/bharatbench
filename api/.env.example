# BharatBench API (api/). Copy to api/.env and fill in. Never commit api/.env.
# Read by app/settings.py (pydantic-settings, case-insensitive) and by a few os.environ lookups noted below.

# ---- Core ----
DATA_DIR=../data                      # SQLite db, uploaded APKs and run artifacts live here
CORS_ORIGINS=http://localhost:3000    # comma-separated origins allowed to call the API (add your Vercel URL)
STORAGE_BACKEND=sqlite                # sqlite (default) or supabase (needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)

# ---- Harness (device lab on EC2) ----
HARNESS_URL=                          # e.g. http://127.0.0.1:8100. Empty = runtime testing skipped, stated in the report
HARNESS_TOKEN=                        # must equal HARNESS_TOKEN in harness/.env (sent as X-Harness-Token)

# ---- Sarvam (voice agent, LLM explanations) ----
SARVAM_API_KEY=                       # server-side only; never expose to the browser
LLM_BASE_URL=https://api.sarvam.ai/v1 # OpenAI-compatible chat completions base URL
LLM_MODEL=sarvam-105b                 # model id used by app/realtime and app/analyzer/explain.py
LLM_API_KEY=                          # optional; falls back to SARVAM_API_KEY
SARVAM_STREAM_STT=true                # use Sarvam streaming speech-to-text (false = REST fallback)
SARVAM_STREAM_TTS=true                # use Sarvam streaming text-to-speech (false = REST fallback)
SARVAM_CHAT_MODEL=sarvam-105b-conversations  # read via os.environ in app/voice/config.py (voice agent)
SARVAM_TTS_MODEL=bulbul:v3            # read via os.environ in app/voice/config.py
SARVAM_TTS_SPEAKER=shubh              # read via os.environ in app/voice/config.py and app/voice/languages.py
ENDPOINT_GRACE_MS=180                 # ms the voice agent holds audio while a speculative turn is confirmed
CONTEST_TIMEOUT_S=3.0                 # seconds before a contested interruption is resolved

# ---- Gnani Prisma STT (optional; inert unless GNANI_API_KEY is set) ----
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_FORMAT=codemix

# ---- Supabase (storage backend and, later, auth) ----
SUPABASE_URL=                         # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side only; bypasses RLS
SUPABASE_JWT_SECRET=                  # optional; HS256 JWT verification for auth (planned, see features/README.md)
AUTH_REQUIRED=false                   # true = reject requests without a verified user (auth not yet enforced by default)

# ---- Misc ----
API_BASE=                             # optional base URL the voice agent prepends to API links; empty = relative
BB_SAMPLE_APK=                        # test only: path to an APK for the optional analyzer smoke test
