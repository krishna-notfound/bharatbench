[Unit]
Description=BharatBench API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/bharatbench/api
EnvironmentFile=/home/ubuntu/bharatbench/api/.env
ExecStart=/home/ubuntu/.local/bin/uv run --frozen uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
