# BharatBench web (web/). Copy to web/.env.local for local dev, or set the same keys in Vercel.
# NEXT_PUBLIC_* values are embedded in the browser bundle. Never put a service-role or Sarvam key here.

# Base URL of the BharatBench API (FastAPI). Local: http://localhost:8000. Production: the HTTPS API host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and anon (publishable) key. Used by web/lib/supabase and the session hook.
# Leave empty to run without sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
