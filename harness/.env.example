# BharatBench harness (harness/, runs on the EC2 device host). Copy to harness/.env. Never commit harness/.env.
# Read by harness/settings.py (pydantic-settings). Defaults shown are the code defaults.

# ---- Required ----
HARNESS_TOKEN=                        # shared secret; generate with: openssl rand -hex 32. Same value goes in api/.env

# ---- Device ----
DEVICE_KIND=redroid                   # redroid (default, Android 12 container) or emulator
ANDROID_SERIAL=127.0.0.1:5555         # adb serial of the device under test
CONTAINER_NAME=redroid                # docker container name used by health checks and self-repair
DOCKER_PATH=docker
ADB_PATH=adb
MAESTRO_PATH=maestro                  # Maestro CLI used to run generated UI flows

# ---- Host tools (absolute paths work too) ----
TC_PATH=/usr/sbin/tc                  # traffic shaping for the budget_2gb and flaky_network profiles
IP_PATH=/usr/sbin/ip
SUDO_PATH=sudo                        # tc runs via sudo -n (NOPASSWD drop-in created by deploy/setup_harness_ec2.sh)
TCPDUMP_PATH=/usr/bin/tcpdump         # cleartext-traffic security check
TIMEOUT_PATH=/usr/bin/timeout

# ---- Jobs and limits ----
JOBS_DIR=./jobs                       # per-job working directories (APK, results, artifacts)
KEEP_JOBS=5                           # job directories kept after cleanup
MAX_APK_MB=300                        # harness-side APK size limit (the API limit is 200 MB)
JOB_TIMEOUT_S=720                     # whole-job timeout
PROFILE_TIMEOUT_S=300                 # one profile longer than this is treated as a device problem
BOOT_TIMEOUT_S=120
RECONNECT_WAIT_S=20

# ---- Security scan ----
SECURITY_ENABLED=true
SECURITY_TIMEOUT_S=150

# ---- Health gate (free disk, MB) ----
MIN_FREE_MB=600                       # below this the lab frees space before running
HARD_MIN_FREE_MB=300                  # below this even after cleanup the job is refused
